SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Lock mode override (optional). Pin the patient lock style across builds:
#   hard = phone locks until verification (production default)
#   soft = phone locks but user can dismiss after 5 taps (dev / QA)
# Unset to let the user choose in Profile → Lock style.
# Higher-priority override: flutter run --dart-define=MEDBUDDY_LOCK_MODE=soft
MEDBUDDY_LOCK_MODE=

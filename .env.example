SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Dose alarm override (optional). Pin whether the phone rings across builds:
#   on  = rings at dose time + 15 min until the dose is verified (production)
#   off = reminders only, phone stays quiet (dev / QA)
# Unset to let the user choose in Profile → Dose alarm.
# Higher-priority override: flutter run --dart-define=MEDBUDDY_ALARM=off
#
# Keep this off on dev machines. A build that rings your device every 15
# minutes while you are working gets uninstalled fast.
MEDBUDDY_ALARM=off

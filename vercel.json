{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm --prefix nextjs-dashboard install",
  "buildCommand": "npm --prefix nextjs-dashboard run build",
  "outputDirectory": "nextjs-dashboard/.next",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi"
}
